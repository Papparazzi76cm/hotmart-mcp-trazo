{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {"api/index.ts": {"maxDuration": 30}},
  "rewrites": [
    {"source": "/health", "destination": "/api"},
    {"source": "/mcp", "destination": "/api"},
    {"source": "/.well-known/oauth-protected-resource", "destination": "/api"},
    {"source": "/.well-known/oauth-protected-resource/mcp", "destination": "/api"},
    {"source": "/api/:path*", "destination": "/api"}
  ]
}
