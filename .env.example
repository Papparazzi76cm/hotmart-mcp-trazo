PORT=3000
PUBLIC_URL=https://mcp-hotmart.example.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
# Supabase OAuth 2.1 Server must be enabled in Authentication > OAuth Server.
# Issuer from the dedicated Hotmart Supabase project:
AUTH_ISSUER=https://rlrolpkjhkatasbfcjxa.supabase.co/auth/v1
# Supabase OAuth access tokens use the authenticated audience unless configured otherwise.
AUTH_AUDIENCE=authenticated
# Explicit approved OAuth client IDs, comma separated. Never use a wildcard.
AUTH_ALLOWED_CLIENT_IDS=REPLACE_WITH_REGISTERED_OAUTH_CLIENT_ID
ENCRYPTION_KEY_BASE64=REPLACE_WITH_32_RANDOM_BYTES_BASE64
HOTMART_API_BASE=https://developers.hotmart.com
HOTMART_TOKEN_URL=https://api-sec-vlc.hotmart.com/security/oauth/token
